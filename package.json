{
  "name": "@cryptoapis-io/x402-buyer-sdk",
  "version": "0.3.0",
  "description": "CryptoAPIs x402 buyer SDK — a fetch wrapper that auto-pays HTTP 402 responses (authorize → sign locally → retry). Non-custodial: you provide the signer; keys never enter the SDK.",
  "license": "MIT",
  "author": "Crypto APIs, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoAPIs-io/cryptoapis-x402-buyer-sdk.git"
  },
  "homepage": "https://developers.cryptoapis.io",
  "keywords": [
    "x402",
    "payments",
    "cryptoapis",
    "usdc",
    "stablecoin",
    "fetch",
    "agent",
    "micropayments",
    "non-custodial"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./agent": {
      "types": "./types/agentTool.d.ts",
      "import": "./src/agentTool.js"
    },
    "./ai-sdk": {
      "types": "./types/ai-sdk.d.ts",
      "import": "./src/ai-sdk.js"
    },
    "./langchain": {
      "types": "./types/langchain.d.ts",
      "import": "./src/langchain.js"
    },
    "./function-calling": {
      "types": "./types/function-calling.d.ts",
      "import": "./src/function-calling.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint ./src/ ./tests/",
    "prepublishOnly": "npm run lint && npm test && npm run build:types",
    "build:types": "tsc"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "ai": ">=3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts"
}
